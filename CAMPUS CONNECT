# PAGE 1: ROLE SELECTION (Landing Page for unauthenticated users)
@app.route('/')
def index():
    if 'user_id' not in session:
        # Show Page 1: Role selector with blank background and logo in center
        return render_template('role_select.html')

    # For logged-in user, display customized dashboard
    dept_filter = request.args.get('department')
    search_query = request.args.get('q')

    query = Question.query.filter_by(is_reported=False)
    if dept_filter:
        query = query.filter_by(target_department=dept_filter)
    if search_query:
        query = query.filter(Question.title.ilike(f"%{search_query}%") | Question.description.ilike(f"%{search_query}%"))

    questions = query.order_by(Question.created_at.desc()).all()
    return render_template('index.html', questions=questions, selected_dept=dept_filter, search_query=search_query)

# PAGE 2: SIGN IN USING COLLEGE EMAIL (Top-left logo)
@app.route('/login', methods=['GET', 'POST'])
def login():
    if 'user_id' in session:
        return redirect(url_for('index'))

    # Allow query parameter ?role=student/faculty/alumni
    role_param = request.args.get('role')
    if role_param in ['student', 'faculty', 'alumni']:
        session['intended_role'] = role_param

    intended_role = session.get('intended_role', 'student')

    if request.method == 'POST':
        email = request.form.get('email', '').strip().lower()
        role_from_form = request.form.get('intended_role')
        if role_from_form in ['student', 'faculty', 'alumni']:
            intended_role = role_from_form
            session['intended_role'] = role_from_form

        if not is_valid_college_email(email):
            flash(f"Please use a valid college email address{' ending with ' + Config.COLLEGE_EMAIL_DOMAIN if Config.COLLEGE_EMAIL_DOMAIN else ''}.", "danger")
            return render_template('login.html', intended_role=intended_role)

        user = User.query.filter_by(college_email=email).first()

        # Direct sign-in without OTP if email ends with @sece.ac.in
        if email.endswith('@sece.ac.in'):
            if not user:
                session['verified_email'] = email
                flash("SECE college email verified! Please complete your profile.", "success")
                return redirect(url_for('register_profile'))
            
            user.is_verified = True
            db.session.commit()
            session['user_id'] = user.id
            flash(f"Welcome back, {user.full_name}!", "success")
            return redirect(url_for('index'))

        # Generate 6-digit OTP for non-sece emails
        otp_code = str(random.randint(100000, 999999))
        expires_at = datetime.utcnow() + timedelta(minutes=10)

        otp_record = EmailOTP(email=email, otp_code=otp_code, expires_at=expires_at)
        db.session.add(otp_record)
        db.session.commit()

        send_otp_email(email, otp_code)
        session['pending_email'] = email
        flash(f"A 6-digit OTP has been sent to {email}. (Check console/inbox)", "info")
        return redirect(url_for('verify_otp'))

    return render_template('login.html', intended_role=intended_role)

@app.route('/verify-otp', methods=['GET', 'POST'])
def verify_otp():
    pending_email = session.get('pending_email')
    if not pending_email:
        flash("Please initiate login first.", "warning")
        return redirect(url_for('login'))

    if request.method == 'POST':
        entered_otp = request.form.get('otp', '').strip()
        record = EmailOTP.query.filter_by(email=pending_email, is_used=False).order_by(EmailOTP.created_at.desc()).first()

        if record and record.otp_code == entered_otp and record.expires_at > datetime.utcnow():
            record.is_used = True
            user = User.query.filter_by(college_email=pending_email).first()

            if not user:
                session['verified_email'] = pending_email
                session.pop('pending_email', None)
                flash("Email verified! Please complete your registration profile.", "success")
                return redirect(url_for('register_profile'))
            
            user.is_verified = True
            db.session.commit()
            session['user_id'] = user.id
            session.pop('pending_email', None)
            flash(f"Welcome back, {user.full_name}!", "success")
            return redirect(url_for('index'))
        else:
            flash("Invalid or expired OTP. Please try again.", "danger")

    return render_template('verify_otp.html', email=pending_email)

@app.route('/register-profile', methods=['GET', 'POST'])
def register_profile():
    verified_email = session.get('verified_email')
    if not verified_email:
        flash("Please verify your college email first.", "warning")
        return redirect(url_for('login'))

    if request.method == 'POST':
        full_name = request.form.get('full_name', '').strip()
        role = request.form.get('role', 'student')
        department = request.form.get('department')
        year_of_study = request.form.get('year_of_study')

        if not full_name or not department or not year_of_study:
            flash("All fields are required.", "danger")
            intended_role = session.get('intended_role', 'student')
            return render_template('register_profile.html', email=verified_email, intended_role=intended_role)

        user = User(
            full_name=full_name,
            college_email=verified_email,
            role=role,
            department=department,
            year_of_study=year_of_study,
            is_verified=True
        )
        db.session.add(user)
        db.session.commit()

        session.pop('verified_email', None)
        session['user_id'] = user.id
        flash("Registration complete! Welcome to CampusConnect.", "success")
        return redirect(url_for('index'))

    intended_role = session.get('intended_role', 'student')
    return render_template('register_profile.html', email=verified_email, intended_role=intended_role)

