@app.context_processor
def inject_global_data():
    unread_count = 0
    current_user = None
    if 'user_id' in session:
        current_user = User.query.get(session['user_id'])
        if current_user:
            unread_count = Notification.query.filter_by(user_id=current_user.id, is_read=False).count()
    return dict(
        current_user=current_user,
        unread_notifications_count=unread_count,
        departments=DEPARTMENTS,
        years=YEARS
    )

def is_valid_college_email(email):
    domain = Config.COLLEGE_EMAIL_DOMAIN.strip().lower()
    if not email or '@' not in email:
        return False
    if domain:
        return email.lower().endswith(domain)
    return True

def send_otp_email(to_email, otp_code):
    try:
        if not app.config.get('MAIL_USERNAME'):
            print(f"\n==========================================")
            print(f"[OTP SIMULATION] Verification code for {to_email}: {otp_code}")
            print(f"==========================================\n")
            return True
        msg = Message(
            subject="CampusConnect Verification Code",
            recipients=[to_email],
            body=f"Your CampusConnect OTP is: {otp_code}. It will expire in 10 minutes.\nDo not share this OTP with anyone."
        )
        mail.send(msg)
        return True
    except Exception as e:
        print(f"Failed to send email: {e}")
        return False

def send_notification_email(to_email, question_title):
    try:
        if not app.config.get('MAIL_USERNAME'):
            print(f"[NOTIFY SIMULATION] Answer notification sent to {to_email} for doubt: {question_title}")
            return True
        msg = Message(
            subject="New Private Answer Received - CampusConnect",
            recipients=[to_email],
            body=f"Hello!\n\nA faculty/senior/alumni has answered your doubt: '{question_title}'.\n\nPlease log in to CampusConnect to view your private answer.\nBest regards,\nCampusConnect Team"
        )
        mail.send(msg)
        return True
    except Exception as e:
        print(f"Failed to send notification email: {e}")
        return False

