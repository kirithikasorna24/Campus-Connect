@app.route('/ask-question', methods=['GET', 'POST'])
def ask_question():
    if 'user_id' not in session:
        flash("You must be logged in with college email to post a doubt.", "warning")
        return redirect(url_for('login'))

    if request.method == 'POST':
        target_department = request.form.get('target_department')
        title = request.form.get('title', '').strip()
        description = request.form.get('description', '').strip()

        if not target_department or not title or not description:
            flash("All fields are required.", "danger")
            return render_template('ask_question.html')

        question = Question(
            asker_id=session['user_id'],
            target_department=target_department,
            title=title,
            description=description
        )
        db.session.add(question)
        db.session.commit()
        flash("Your question has been posted to the public board! Answers will be privately delivered to you.", "success")
        return redirect(url_for('question_detail', question_id=question.id))

    return render_template('ask_question.html')

@app.route('/question/<int:question_id>', methods=['GET', 'POST'])
def question_detail(question_id):
    question = Question.query.get_or_404(question_id)
    current_user_id = session.get('user_id')
    current_user = User.query.get(current_user_id) if current_user_id else None

    # Answers are STRICTLY PRIVATE: visible only to asker or the responder
    if current_user:
        if current_user.id == question.asker_id or current_user.role == 'admin':
            answers = Answer.query.filter_by(question_id=question.id).order_by(Answer.created_at.desc()).all()
        else:
            answers = Answer.query.filter_by(question_id=question.id, responder_id=current_user.id).order_by(Answer.created_at.desc()).all()
    else:
        answers = []

    total_answers_count = len(question.answers)

    return render_template(
        'question_detail.html',
        question=question,
        answers=answers,
        total_answers_count=total_answers_count
    )

@app.route('/question/<int:question_id>/answer', methods=['POST'])
def post_answer(question_id):
    if 'user_id' not in session:
        flash("You must be logged in to answer questions.", "danger")
        return redirect(url_for('login'))

    question = Question.query.get_or_404(question_id)
    content = request.form.get('content', '').strip()

    if not content:
        flash("Answer cannot be empty.", "danger")
        return redirect(url_for('question_detail', question_id=question.id))

    answer = Answer(
        question_id=question.id,
        responder_id=session['user_id'],
        content=content
    )
    db.session.add(answer)

    question.status = 'answered'

    # Notify asker
    notification = Notification(
        user_id=question.asker_id,
        message=f"Someone answered your question: '{question.title[:40]}...'",
        link=url_for('question_detail', question_id=question.id)
    )
    db.session.add(notification)
    db.session.commit()

    send_notification_email(question.asker.college_email, question.title)

    flash("Your private answer has been submitted to the question asker!", "success")
    return redirect(url_for('question_detail', question_id=question.id))

@app.route('/my-doubts')
def my_doubts():
    if 'user_id' not in session:
        flash("Please log in to view your doubts.", "warning")
        return redirect(url_for('login'))

    user = User.query.get(session['user_id'])
    questions = Question.query.filter_by(asker_id=user.id).order_by(Question.created_at.desc()).all()
    
    # Also fetch questions the user has answered
    answered_ids = [a.question_id for a in Answer.query.filter_by(responder_id=user.id).all()]
    answered_questions = Question.query.filter(Question.id.in_(answered_ids)).all() if answered_ids else []

    return render_template('my_doubts.html', questions=questions, answered_questions=answered_questions)

@app.route('/notifications')
def notifications():
    if 'user_id' not in session:
        flash("Please log in to view notifications.", "warning")
        return redirect(url_for('login'))

    user_id = session['user_id']
    notes = Notification.query.filter_by(user_id=user_id).order_by(Notification.created_at.desc()).all()
    
    # Mark as read
    for n in notes:
        n.is_read = True
    db.session.commit()

    return render_template('notifications.html', notifications=notes)

@app.route('/admin')
def admin_dashboard():
    if 'user_id' not in session:
        flash("Admin login required.", "danger")
        return redirect(url_for('login'))

    user = User.query.get(session['user_id'])
    if not user or user.role != 'admin':
        flash("Access denied. Admin rights required.", "danger")
        return redirect(url_for('index'))

    reported_questions = Question.query.filter_by(is_reported=True).all()
    all_users = User.query.all()
    return render_template('admin.html', reported_questions=reported_questions, users=all_users)

@app.route('/report-question/<int:question_id>', methods=['POST'])
def report_question(question_id):
    question = Question.query.get_or_404(question_id)
    question.is_reported = True
    db.session.commit()
    flash("The question has been reported for review.", "warning")
    return redirect(url_for('index'))

@app.route('/delete-question/<int:question_id>', methods=['POST'])
def delete_question(question_id):
    if 'user_id' not in session:
        flash("Access denied.", "danger")
        return redirect(url_for('login'))

    user = User.query.get(session['user_id'])
    question = Question.query.get_or_404(question_id)

    if user.role != 'admin' and user.id != question.asker_id:
        flash("You are not authorized to delete this.", "danger")
        return redirect(url_for('index'))

    db.session.delete(question)
    db.session.commit()
    flash("Question successfully deleted.", "info")
    return redirect(url_for('index'))

